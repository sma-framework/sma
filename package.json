{
  "name": "sma-framework",
  "version": "5.6.1",
  "description": "SMA (Shared Memory & Automation) - the accountability layer for AI coding agents: layered memory, multi-terminal coordination without a server, and verified claims. Plain files + git, zero LLM in the hot path. Install: npx -y sma-framework@latest init",
  "author": "Matvey Maslov <matvey.maslov99@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sma-framework/sma.git"
  },
  "homepage": "https://github.com/sma-framework/sma#readme",
  "bugs": {
    "url": "https://github.com/sma-framework/sma/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "agent-memory",
    "coding-agent",
    "multi-terminal",
    "coordination",
    "calibration",
    "receipts",
    "claude",
    "llm"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sma-framework": "bin/init.mjs",
    "sma-init": "bin/init.mjs",
    "sma-tools": "sma-core/bin/sma-tools.cjs",
    "sma_run": "sma-core/bin/sma_run"
  },
  "files": [
    "sma-core",
    "scripts/sma",
    "daemon",
    "supervisor",
    "bin",
    "docs",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "THIRD-PARTY-LICENSES.md"
  ],
  "scripts": {
    "test": "vitest run && node scripts/sma/lib/badge.mjs --check && node tools/verify-rebrand.mjs",
    "badge": "vitest run --reporter=json --outputFile=.vitest-report.json && node scripts/sma/lib/badge.mjs --from-vitest .vitest-report.json",
    "build:spa": "npm --prefix spa run build",
    "daemon:stop": "node supervisor/daemon-control.mjs stop",
    "daemon:restart": "node supervisor/daemon-control.mjs restart",
    "daemon:watch": "node supervisor/daemon-watch.mjs",
    "prepublishOnly": "npm run build:spa && node scripts/sma/lib/package-check.mjs --strict && node tools/verify-rebrand.mjs && node scripts/sma/lib/release-lint.mjs",
    "sma": "node scripts/sma/cli.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "vitest": "^4.1.4"
  }
}
